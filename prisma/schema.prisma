generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Book {
  id        Int      @id @default(autoincrement())
  judul     String
  penulis   String
  warna     String   @default("#8C6FB0")
  createdAt DateTime @default(now())

  @@map("books")
}